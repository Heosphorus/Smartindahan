{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:memory",
        "--prefix",
        "backend"
      ],
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}