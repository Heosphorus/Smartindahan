# Base URL of the backend API, including the /api suffix, with no trailing slash.
#
# Local development: leave this unset (or "/api"). Vite proxies /api to http://localhost:5000.
# Vercel single-project deployment (frontend and API on one domain): leave unset (or "/api").
# GitHub Pages (frontend only): the full URL of the deployed backend, set as the repository
#   variable VITE_API_URL, for example https://your-project.vercel.app/api
#
# Never put secrets in VITE_* variables: they are embedded in the public JavaScript bundle.
VITE_API_URL=/api
