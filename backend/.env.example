# Copy to backend/.env for local development. In production set these in the hosting provider
# (Vercel: Project -> Settings -> Environment Variables). Never commit real values.

# Only used by the long-running server (npm run dev / npm start). Ignored on Vercel.
PORT=5000
NODE_ENV=development

# MongoDB connection string. Include the database name in the path (…mongodb.net/smartindahan?…);
# without one MongoDB silently uses the "test" database.
# Atlas: Connect -> Drivers. If your network blocks SRV DNS lookups ("querySrv ECONNREFUSED"),
# use the standard mongodb:// (non +srv) string from the same screen.
MONGODB_URI=mongodb://127.0.0.1:27017/smartindahan

# Required in production: at least 32 random characters, not a placeholder.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value-before-running
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (CORS), comma-separated, exact origins only
# (scheme + host [+ port], no path). Production requires https:// origins, for example:
#   FRONTEND_URL=https://your-project.vercel.app,https://your-user.github.io
FRONTEND_URL=http://localhost:5173

# Email delivery.
#   development: nothing is sent; only the recipient and subject are logged.
#   production:  required when NODE_ENV=production.
EMAIL_MODE=development
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=smarTindahan <onboarding@resend.dev>
# SMTP alternative (EMAIL_PROVIDER=smtp)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Days between a deletion request and permanent deletion (users can cancel meanwhile). Default 14.
# Run `npm run purge-deleted-accounts` on a schedule (daily) so due accounts are actually deleted.
# ACCOUNT_DELETION_GRACE_DAYS=14

# Optional connection-pool tuning (defaults: 20/2, or 5/0 on Vercel).
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=2

# Only for `npm run create-admin`: set in your shell, do not store in a committed file.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
